<Window x:Class="Gnomon.Agent.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Gnomon" Height="650" Width="570" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,22">
      <TextBlock Text="Connect Gnomon" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Tell this Windows agent where to report screen time." Foreground="#666" Margin="0,4,0,0"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Home Assistant address" FontWeight="SemiBold"/>
    <TextBox Grid.Row="2" x:Name="HaAddressText" Margin="0,6,0,4" Padding="9,7"/>
    <TextBlock Grid.Row="3" Text="homeassistant.local works for most local installations. HTTP, HTTPS, WS and WSS addresses are also accepted."
               Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,16"/>

    <StackPanel Grid.Row="4">
      <TextBlock Text="Long-lived access token" FontWeight="SemiBold"/>
      <PasswordBox x:Name="TokenText" Margin="0,6,0,4" Padding="9,7"/>
      <TextBlock Text="Create one in your Home Assistant profile under Security → Long-lived access tokens."
                 Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,16"/>
    </StackPanel>

    <Grid Grid.Row="5" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Kid ID" FontWeight="SemiBold"/>
        <TextBox x:Name="KidText" Margin="0,6,0,0" Padding="9,7"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Device ID" FontWeight="SemiBold"/>
        <TextBox x:Name="DeviceText" Margin="0,6,0,0" Padding="9,7"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="6">
      <TextBlock Text="Windows account to track" FontWeight="SemiBold"/>
      <TextBox x:Name="WindowsUserText" Margin="0,6,0,4" Padding="9,7"/>
      <TextBlock Text="Enter the Windows sign-in name used by the person this device belongs to."
                 Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,16"/>
    </StackPanel>

    <Border Grid.Row="7" Background="#EEF5FF" CornerRadius="5" Padding="12" Margin="0,0,0,16">
      <TextBlock x:Name="StatusText" Text="Configuration is stored on this PC and used only to connect directly to your Home Assistant instance."
                 Foreground="#214A75" TextWrapping="Wrap"/>
    </Border>

    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Width="92" Padding="8" Margin="0,0,10,0" Click="Cancel_Click"/>
      <Button x:Name="SaveButton" Content="Save and start" Width="126" Padding="8" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
