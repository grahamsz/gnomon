<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Gnomon Agent" Manufacturer="Gnomon" Version="$(var.Version)"
           UpgradeCode="A10D289A-975E-44F1-B662-DF80D9AFCE54"
           Scope="perMachine" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Gnomon Agent is already installed."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
    <Launch Condition="Installed OR WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED"
            Message="Gnomon requires .NET Framework 4.8 or later, which is included with current Windows versions." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Gnomon">
        <Component Id="AgentBinary" Guid="D51CC460-7391-4877-8BA3-694F2CC4B94C" Bitness="always64">
          <File Id="AgentExe" Source="$(var.AgentPublishDir)\Gnomon.Agent.exe" KeyPath="yes" />
          <File Id="AgentConfig" Source="$(var.AgentPublishDir)\Gnomon.Agent.exe.config" />
          <File Id="CoreAssembly" Source="$(var.AgentPublishDir)\Gnomon.Core.dll" />
          <File Id="AsyncInterfaces" Source="$(var.AgentPublishDir)\Microsoft.Bcl.AsyncInterfaces.dll" />
          <File Id="NAudioCore" Source="$(var.AgentPublishDir)\NAudio.Core.dll" />
          <File Id="NAudioWasapi" Source="$(var.AgentPublishDir)\NAudio.Wasapi.dll" />
          <File Id="Serilog" Source="$(var.AgentPublishDir)\Serilog.dll" />
          <File Id="SerilogFileSink" Source="$(var.AgentPublishDir)\Serilog.Sinks.File.dll" />
          <File Id="SystemBuffers" Source="$(var.AgentPublishDir)\System.Buffers.dll" />
          <File Id="DiagnosticSource" Source="$(var.AgentPublishDir)\System.Diagnostics.DiagnosticSource.dll" />
          <File Id="SystemMemory" Source="$(var.AgentPublishDir)\System.Memory.dll" />
          <File Id="NumericsVectors" Source="$(var.AgentPublishDir)\System.Numerics.Vectors.dll" />
          <File Id="CompilerUnsafe" Source="$(var.AgentPublishDir)\System.Runtime.CompilerServices.Unsafe.dll" />
          <File Id="TextEncodingsWeb" Source="$(var.AgentPublishDir)\System.Text.Encodings.Web.dll" />
          <File Id="SystemTextJson" Source="$(var.AgentPublishDir)\System.Text.Json.dll" />
          <File Id="ThreadingChannels" Source="$(var.AgentPublishDir)\System.Threading.Channels.dll" />
          <File Id="TaskExtensions" Source="$(var.AgentPublishDir)\System.Threading.Tasks.Extensions.dll" />
          <File Id="SystemValueTuple" Source="$(var.AgentPublishDir)\System.ValueTuple.dll" />
          <File Id="LicenseFile" Source="..\..\LICENSE" Name="LICENSE.txt" />
          <ServiceInstall Id="AgentService" Name="GnomonAgent" DisplayName="Gnomon Screen Time Agent"
                          Description="Keeps the visible Gnomon session worker running."
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                          Arguments="--service" />
          <ServiceControl Id="AgentServiceControl" Name="GnomonAgent" Start="install"
                          Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="RunKey" Guid="0D2387CB-B242-402C-950D-0C95F51ECA60" Bitness="always64">
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                         Name="GnomonAgent" Value="&quot;[INSTALLDIR]Gnomon.Agent.exe&quot;"
                         Type="string" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataDir" Name="Gnomon">
        <Component Id="ConfigData" Guid="F78A7D93-27D0-4D69-AEA8-D0881BC38220" Permanent="yes" NeverOverwrite="yes">
          <File Id="ConfigFile" Source="config.json" Name="config.json" KeyPath="yes" />
        </Component>
        <Directory Id="LogsDir" Name="logs">
          <Component Id="LogsDirectory" Guid="ACF2B92F-4525-4DFD-A6B4-8FF3E406C034" Permanent="yes">
            <CreateFolder><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" Delete="yes" /></CreateFolder>
            <RegistryValue Root="HKLM" Key="SOFTWARE\Gnomon" Name="LogsCreated" Value="1" Type="integer" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Gnomon Agent" Level="1">
      <ComponentRef Id="AgentBinary"/><ComponentRef Id="RunKey"/>
      <ComponentRef Id="ConfigData"/><ComponentRef Id="LogsDirectory"/>
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Installation is complete. Continue to connect Gnomon to Home Assistant." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Configure Gnomon now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchConfiguration" FileRef="AgentExe" ExeCommand="--configure"
                  Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchConfiguration"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <CustomAction Id="ConfigureFailureActions" Directory="System64Folder"
                  ExeCommand="sc.exe failure GnomonAgent reset= 86400 actions= restart/5000/restart/5000/restart/30000"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="ConfigureFailureActions" After="StartServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
