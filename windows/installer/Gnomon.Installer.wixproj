<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <OutputName>GnomonAgent-$(Version)-x64</OutputName>
    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">..\src\Gnomon.Agent\bin\Release\net48\publish</AgentPublishDir>
    <BrowserExtensionDir Condition="'$(BrowserExtensionDir)' == ''">..\browser-extension</BrowserExtensionDir>
    <DefineConstants>Version=$(Version);AgentPublishDir=$(AgentPublishDir);BrowserExtensionDir=$(BrowserExtensionDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
  </ItemGroup>
  <Target Name="SignMsi" AfterTargets="Build" Condition="'$(SignCertificate)' != ''">
    <Exec Command="signtool sign /fd SHA256 /f &quot;$(SignCertificate)&quot; /p &quot;$(SignPassword)&quot; &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
